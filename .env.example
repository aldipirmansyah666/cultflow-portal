# Supabase (public — aman untuk browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-only — JANGAN expose ke browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth session (server-only) — generate: openssl rand -hex 32 (min 32 karakter)
JWT_SECRET=your-32-plus-char-secret-here

# App
# NEXT_PUBLIC_APP_URL=http://localhost:3000
